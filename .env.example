# ─── Domaine et HTTPS ────────────────────────────────────────────────
# COMPOSE_PROFILES=caddy : Caddy gère HTTPS sur les ports 80/443 (serveur dédié à mesvotes).
# Laisse vide si un autre serveur web (Nginx, Apache…) occupe déjà ces ports :
# il redirigera mesvotes.fr vers 127.0.0.1:APP_PORT (voir docs/reverse-proxy.md).
COMPOSE_PROFILES=caddy
# Port local de l'application (jamais exposé sur internet).
APP_PORT=3010
# Nom de domaine pointant vers ce serveur (enregistrement DNS A/AAAA).
DOMAIN=mesvotes.fr
# Adresse utilisée par Let's Encrypt pour les alertes de certificat.
ACME_EMAIL=
# Adresse publique du site (sert aux liens dans les e-mails et aux cookies sécurisés).
BASE_URL=https://mesvotes.fr

# ─── Mentions légales (page « Mentions légales et confidentialité ») ─
# Éditeur et responsable des données. Un particulier peut ne pas publier son adresse
# s'il indique celle de l'hébergeur (loi pour la confiance dans l'économie numérique, art. 6).
LEGAL_NAME=Eliot Faggianelli
# Adresse de contact affichée (signalements de contenus illicites, droits RGPD).
LEGAL_EMAIL=
LEGAL_ADDRESS=
# Hébergeur du serveur (ton fournisseur de VPS) : nom, adresse, téléphone, pays.
HOSTING_NAME=
HOSTING_ADDRESS=
HOSTING_PHONE=
HOSTING_LOCATION=France

# Objectif affiché sur l'accueil.
GOAL_MEMBERS=1000000

# ─── Administration ─────────────────────────────────────────────────
# Le compte inscrit avec cet e-mail devient administrateur.
# Laissé vide : le premier compte créé devient administrateur.
ADMIN_EMAIL=

# ─── Mode démo ──────────────────────────────────────────────────────
# DEMO_MODE=true : les administrateurs voient un bouton pour passer à l'étape suivante.
DEMO_MODE=false
# SEED_DEMO=true : au premier lancement, charge des propositions et des lois d'exemple
# (avec des comptes fictifs sans mot de passe, comptés dans le corps électoral).
SEED_DEMO=false

# ─── E-mails (facultatif) ───────────────────────────────────────────
# Sans SMTP, l'inscription fonctionne sans confirmation d'adresse
# et les liens sont écrits dans les journaux : docker compose logs app
# Avec SMTP, chaque compte doit confirmer son adresse avant de proposer, parrainer ou voter.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=mesvotes <ne-pas-repondre@mesvotes.fr>

# ─── Anti-robot (inscription, connexion, mot de passe oublié) ───────
# Difficulté de la preuve de travail : +1 double le calcul (17 ≈ 0,2 s sur un téléphone récent).
ANTIBOT_BITS=17
# Délai minimum (secondes) entre l'affichage du formulaire et son envoi.
ANTIBOT_MIN_SECONDS=2
# Clé de signature des défis (facultatif : une clé aléatoire est créée à chaque démarrage).
ANTIBOT_SECRET=

# ─── Divers ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
# Espace total de fichiers joints par compte (les fichiers non rattachés sont supprimés au bout de 24 h).
MAX_USER_STORAGE_MB=200
# Fréquence (en secondes) de l'horloge qui fait avancer les phases.
TICK_SECONDS=60

# ─── Constitution fondatrice (lue une seule fois, au tout premier lancement) ─
# Utile pour démarrer à quelques personnes : sinon il faut 50 parrains minimum.
# Ensuite, ces règles ne changent plus que par une révision votée.
# INIT_PROJET_MIN=15
# INIT_PROJET_MAX=90
# INIT_PARRAINAGE_PCT=1
# INIT_PARRAINAGE_MIN=50
# INIT_PARRAINAGE_DAYS=60
# INIT_DELIB_MIN=90
# INIT_DELIB_MAX=180
# INIT_VOTE_DAYS=7
# INIT_MAJORITY_PCT=50
# INIT_QUORUM_PCT=5
# INIT_CONST_MAJORITY_PCT=60
# INIT_CONST_QUORUM_PCT=10
