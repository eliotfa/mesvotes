# ─── Domaine et HTTPS ────────────────────────────────────────────────
# Nom de domaine pointant vers ce serveur (enregistrement DNS A/AAAA).
DOMAIN=mesvotes.fr
# Adresse utilisée par Let's Encrypt pour les alertes de certificat.
ACME_EMAIL=
# Adresse publique du site (sert aux liens dans les e-mails et aux cookies sécurisés).
BASE_URL=https://mesvotes.fr

# ─── Administration ─────────────────────────────────────────────────
# Le compte inscrit avec cet e-mail devient administrateur.
# Laissé vide : le premier compte créé devient administrateur.
ADMIN_EMAIL=

# ─── Mode démo ──────────────────────────────────────────────────────
# DEMO_MODE=true : les administrateurs voient un bouton pour passer à l'étape suivante.
DEMO_MODE=false
# SEED_DEMO=true : au premier lancement, charge des propositions et des lois d'exemple
# (avec des comptes fictifs sans mot de passe, comptés dans le corps électoral).
SEED_DEMO=false

# ─── E-mails (facultatif) ───────────────────────────────────────────
# Sans SMTP, l'inscription fonctionne sans confirmation d'adresse
# et les liens sont écrits dans les journaux : docker compose logs app
# Avec SMTP, chaque compte doit confirmer son adresse avant de proposer, parrainer ou voter.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=mesvotes <ne-pas-repondre@mesvotes.fr>

# ─── Divers ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
# Fréquence (en secondes) de l'horloge qui fait avancer les phases.
TICK_SECONDS=60

# ─── Constitution fondatrice (lue une seule fois, au tout premier lancement) ─
# Utile pour démarrer à quelques personnes : sinon il faut 50 parrains minimum.
# Ensuite, ces règles ne changent plus que par une révision votée.
# INIT_PROJET_MIN=15
# INIT_PROJET_MAX=90
# INIT_PARRAINAGE_PCT=1
# INIT_PARRAINAGE_MIN=50
# INIT_PARRAINAGE_DAYS=60
# INIT_DELIB_MIN=90
# INIT_DELIB_MAX=180
# INIT_VOTE_DAYS=7
# INIT_MAJORITY_PCT=50
# INIT_QUORUM_PCT=5
# INIT_CONST_MAJORITY_PCT=60
# INIT_CONST_QUORUM_PCT=10
